#!/usr/bin/env bash
# Refuse a push whose build does not pass, and whose privacy passes did not actually RUN.
#
# WHY THIS EXISTS. CLAUDE.md rule 5 already says: "Before pushing, confirm `npm run build`
# is clean AND that the literal and history passes actually ran rather than skipping."
# That was a rule an agent had to remember, and on 2026-09-06 one did not:
#
#   npm run build 2>&1 | grep -E "clean|error"
#
# The grep MATCHED the error line, exited 0, and the `&&` chain went on to merge and push.
# The pipeline reported success by successfully finding the failure. `npm run build` had
# exited 2. Main was red for one commit.
#
# The same shape had already happened once that day with `npm test | tail -2`, which cut
# off the FAIL line and left the absence of a verdict reading as a pass. Twice in one day,
# filtering command output for brevity hid the thing the command was run to discover.
#
# So this hook does the one thing a text filter cannot be fooled about: it checks the EXIT
# CODE. Nothing here greps for "clean".
#
# THE SECOND HALF IS THE SUBTLE ONE. A fresh clone has no .private-patterns, so the
# literal and history passes SKIP and the build still says "clean - no personal data would
# ship". That is a clean build on evidence nobody gathered, and rule 5 names it explicitly.
# So this also refuses when those passes did not run - the failure mode is a confident
# green on an unchecked tree, which is exactly what this repo has leaked through twice.
#
# Escape hatch: `git push --no-verify`. Deliberately left available and deliberately not
# advertised in the failure message - an agent that needs it can find it, and a rule with
# a convenient documented bypass is not a rule.

set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT" || exit 1

# Nothing to check on a delete or a tags-only push.
if [[ -z "${1:-}" ]]; then :; fi

echo "pre-push: running npm run build (exit code is the verdict, not the text)"
OUT="$(npm run build 2>&1)"
RC=$?

if [[ $RC -ne 0 ]]; then
  echo "PUSH REFUSED: npm run build exited $RC." >&2
  echo "$OUT" | tail -25 >&2
  exit 1
fi

# Rule 5's other half: the passes must have RUN, not skipped.
#
# Matched on the literal-check LINE, not on the word SKIPPED anywhere in the build. The
# first version grepped the whole output and refused every push, because
# check_price_bands.py legitimately prints "SKIPPED - section assignment" while the chart
# is untranscribed. A guard that blocks every push is one that gets deleted, so the signal
# has to be the exact line check_privacy.py emits when it has no patterns file:
#
#   literal check:    SKIPPED (no .private-patterns; structural check only)
if ! grep -qE "^literal check:" <<<"$OUT" || grep -qE "^literal check:.*SKIPPED" <<<"$OUT"; then
  echo "PUSH REFUSED: the build passed, but the literal/history privacy passes did not" >&2
  echo "actually run - .private-patterns is missing, so 'clean' means 'nothing was" >&2
  echo "checked'. Recreate it before pushing. See CLAUDE.md rule 1." >&2
  exit 1
fi

echo "pre-push: build clean, privacy passes ran."
exit 0
